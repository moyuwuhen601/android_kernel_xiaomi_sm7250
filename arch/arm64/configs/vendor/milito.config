CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PINCTRL_LPI=y
CONFIG_AUDIO_EXT_CLK=y
CONFIG_SND_SOC_WCD9XXX_V2=y
CONFIG_SND_SOC_WCD_MBHC=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_WSA883X=y
CONFIG_WCD9XXX_CODEC_CORE_V2=y
CONFIG_MSM_CDC_PINCTRL=y
CONFIG_MSM_QDSP6V2_CODECS=y
CONFIG_MSM_ULTRASOUND=y
CONFIG_MSM_QDSP6_APRV2_RPMSG=y
CONFIG_MSM_ADSP_LOADER=y
CONFIG_REGMAP_SWR=y
CONFIG_MSM_QDSP6_SSR=y
CONFIG_MSM_QDSP6_PDR=y
CONFIG_MSM_QDSP6_NOTIFIER=y
CONFIG_SND_SOC_MSM_HOSTLESS_PCM=y
CONFIG_SND_SOC_MSM_QDSP6V2_INTF=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_MSTR_CTRL=y
CONFIG_SND_SOC_QDSP6V2=y
CONFIG_SND_SOC_WCD_MBHC_ADC=y
CONFIG_SND_SOC_MSM_HDMI_CODEC_RX=y
CONFIG_QTI_PP=y
CONFIG_SND_HWDEP_ROUTING=y
CONFIG_SND_SOC_MSM_STUB=y
CONFIG_MSM_AVTIMER=y
CONFIG_SND_SOC_BOLERO=y
CONFIG_WSA_MACRO=y
CONFIG_VA_MACRO=y
CONFIG_RX_MACRO=y
CONFIG_TX_MACRO=y
CONFIG_DIGITAL_CDC_RSC_MGR=y
CONFIG_SND_SOC_WCD_IRQ=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SLAVE=y
CONFIG_SND_SOC_WCD937X=y
CONFIG_SND_SOC_WCD937X_SLAVE=y
CONFIG_SND_SOC_LITO=y
CONFIG_SND_EVENT=y
CONFIG_SND_SOC_CS35L41=y
CONFIG_SND_SOC_TFA9874=y
CONFIG_MSM_CSPL=y
CONFIG_MI2S_DISABLE=y
CONFIG_TDM_DISABLE=y
CONFIG_AUXPCM_DISABLE=y
CONFIG_UNICODE=y
# CONFIG_UNICODE_NORMALIZATION_SELFTEST is not set
# CONFIG_SCSI_CONSTANTS is not set
# CONFIG_SCSI_LOGGING is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# CONFIG_NL80211_TESTMODE is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_PCI is not set
# CONFIG_MSM_BOOT_STATS is not set
# CONFIG_QTI_RPM_STATS_LOG is not set
# CONFIG_QTI_DDR_STATS_LOG is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# --- picasso / picasso_48m (Redmi K30 5G / K30i 5G) overrides ---
# Touch: Novatek NT36672C over SPI (fw built in from firmware/)
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
# CONFIG_TOUCHSCREEN_FTS is not set
# Side-mounted fingerprint (Goodix TA / FPC TEE); FOD drivers are for monet/vangogh
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
# CONFIG_FINGERPRINT_GOODIX_FOD is not set
# CONFIG_FPR_FPC is not set
# Charging: picasso uses the TI BQ2597x charge pump (not monet's SMB1398) + DS28E16 battery auth
# CONFIG_SMB1398_CHARGER is not set
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y
# ds28e16 sha3 code needs a bigger frame limit (same as reference kernel)
CONFIG_FRAME_WARN=4096
# Vibrator: PMIC LDO motor (qcom,qpnp-vibrator-ldo)
CONFIG_LEDS_QPNP_VIBRATOR_LDO=y
# SIM tray detection
CONFIG_SIMTRAY_STATUS=y
# Bigger kernel log buffer for debugging
CONFIG_LOG_BUF_SHIFT=21
